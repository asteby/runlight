[Unit]
Description=Runlight: PSI-aware autoscaler for GitHub Actions runners
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
SupplementaryGroups=docker
# Credentials live here (0600), never in the unit or argv.
EnvironmentFile=/etc/runlight/env
ExecStart=/usr/local/bin/runlight \
  --url https://github.com/asteby-hq \
  --name runlight \
  --min 0 --max 2 \
  --cpus-per-runner 2 \
  --mem-per-runner-mb 2048 \
  --cgroup-parent runlight.slice \
  --log-json
# Estado persistente (suscripciones push, claves VAPID, ajustes editados desde el panel y
# marcador de reinicio no limpio). Flags nuevos, con sus valores por defecto:
#   --state-dir /var/lib/runlight   (vacío = push y ajustes desactivados)
#   --vapid-subject https://runlight.asteby.com
# El directorio debe poder escribirlo el usuario del servicio: o bien añadir
# StateDirectory=runlight (systemd lo crea con el dueño correcto) o bien
#   sudo install -d -o ubuntu -g ubuntu -m 0700 /var/lib/runlight
# Swap y /tmp (fase 9). El swap lleno con 0 actividad es inofensivo; la causa real es que /tmp es
# tmpfs (RAM) y acumula basura de CI. Flags opcionales para ExecStart (valores recomendados en el VPS):
#   --tmp-clean /tmp:go-link-,ops-seed-bin,wasm-imports-,link-release-build,gt-vps-,node-compile-cache,.pnpm-store:180:ubuntu
#       (repetible; root:prefijos[:minutos[:dueño]]; root solo /tmp, /var/tmp o >=4 segmentos; solo primer nivel;
#        no sigue symlinks; omite lo abierto o usado como cwd por algún proceso; respeta --janitor-dry-run)
#   --no-job-swap
#       (backend systemd: los jobs no pueden usar swap, MemorySwapMax=0; por defecto desactivado)
# Con el backend systemd cada job recibe además TMPDIR=<jobs-dir>/<runner>/tmp en disco (se borra con el job).
Restart=always
RestartSec=5
# Runners are separate containers: restarting the daemon does not kill jobs.
KillMode=process
TimeoutStopSec=60

# The daemon itself is tiny; keep it that way.
MemoryMax=128M
CPUWeight=50
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
